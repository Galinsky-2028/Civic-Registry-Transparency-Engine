# Local PostgreSQL development database.
DATABASE_URL=postgresql://civic_registry:civic_registry@localhost:5432/civic_registry

# Used by docker-compose.yml.
POSTGRES_DB=civic_registry
POSTGRES_USER=civic_registry
POSTGRES_PASSWORD=civic_registry

# Restricted /admin operator console. Requires a signing secret of at least 32
# characters plus server-bound principals: either explicit
# CIVIC_REGISTRY_ADMIN_PRINCIPALS JSON, or three distinct role credentials of at
# least 32 characters that scripts/admin-principals.mjs converts to digests.
# CIVIC_REGISTRY_ADMIN_TOKEN is retired and ignored.
CIVIC_REGISTRY_ADMIN_SESSION_SECRET=
CIVIC_REGISTRY_EDITOR_TOKEN=
CIVIC_REGISTRY_REVIEWER_TOKEN=
CIVIC_REGISTRY_PUBLISHER_TOKEN=
CIVIC_REGISTRY_ADMIN_PRINCIPALS=

# Optional generic HTTP email relay used by notification delivery.
# The relay receives JSON: {to, from, subject, text, metadata}.
CIVIC_REGISTRY_EMAIL_RELAY_URL=
CIVIC_REGISTRY_EMAIL_RELAY_TOKEN=
CIVIC_REGISTRY_EMAIL_FROM=

# Optional Ed25519 keys for signed audit-integrity checkpoints.
# Prefer *_FILE in deployed environments so private key material is not
# embedded directly in process configuration. Inline PEM variables are
# supported by the CLI as a fallback and may use escaped \n newlines.
CIVIC_REGISTRY_INTEGRITY_PRIVATE_KEY_FILE=
CIVIC_REGISTRY_INTEGRITY_PUBLIC_KEY_FILE=
CIVIC_REGISTRY_INTEGRITY_PRIVATE_KEY=
CIVIC_REGISTRY_INTEGRITY_PUBLIC_KEY=
CIVIC_REGISTRY_INTEGRITY_KEY_ID=

# Persistent directory for content-addressed retrieved documents.
CIVIC_REGISTRY_DOCUMENT_STORAGE_DIR=./data/documents

# Explicit opt-ins for an example deployment (fictional bundled records).
CIVIC_REGISTRY_SEED_GENERIC=false
CIVIC_REGISTRY_DEMO=false
